    {
      "column": 57,
      "end_column": 69,
      "end_line": 28,
      "file": "tests/fixtures/luau-shield001/vulnerable/admin-varargs-from-another-client.server.luau",
      "fix": "Use a RemoteEvent for the request and another for the reply (with a server-side timeout), or at least run the invoke in a detached thread (`task.spawn`) with a timeout and validate the returned values.",
      "flow": [
        {
          "column": 57,
          "file": "tests/fixtures/luau-shield001/vulnerable/admin-varargs-from-another-client.server.luau",
          "line": 28,
          "note": "`ReplicatedStorage.Remotes.GetLocalCoins:InvokeClient()` makes the server wait for an answer from a client, which may never come"
        }
      ],
      "help_uri": "https://github.com/Topogamer0/luau-shield/blob/main/docs/rules/luau-shield006.md",
      "line": 28,
      "message": "`ReplicatedStorage.Remotes.GetLocalCoins:InvokeClient()` makes the server wait for an answer from a client, which may never come",
      "rule": "luau-shield006",
      "severity": "medium",
      "slug": "server-invokes-client",
      "snippet": "\trecord(target, ReplicatedStorage.Remotes.GetLocalCoins:InvokeClient(target)) -- expect: luau-shield006",
      "title": "Server waits for a client with RemoteFunction:InvokeClient",
      "why": "A malicious client can simply never return: the server thread yields forever (pcall does not help), leaking memory and blocking whatever logic waits for the answer. A client that errors or leaves also breaks the call, and every value it returns is client-controlled."
    },
    {
      "column": 62,
      "end_column": 74,
      "end_line": 29,
      "file": "tests/fixtures/luau-shield001/vulnerable/admin-varargs-from-another-client.server.luau",
      "fix": "Use a RemoteEvent for the request and another for the reply (with a server-side timeout), or at least run the invoke in a detached thread (`task.spawn`) with a timeout and validate the returned values.",
      "flow": [
        {
          "column": 62,
          "file": "tests/fixtures/luau-shield001/vulnerable/admin-varargs-from-another-client.server.luau",
          "line": 29,
          "note": "`ReplicatedStorage.Remotes.GetLocalCoins:InvokeClient()` makes the server wait for an answer from a client, which may never come"
        }
