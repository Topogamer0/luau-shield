      ],
      "help_uri": "https://github.com/Topogamer0/luau-shield/blob/main/docs/rules/luau-shield007.md",
      "line": 20,
      "message": "the `ReplicatedStorage.Remotes.SetBio.OnServerEvent` handler calls `store:SetAsync()` on every request, with no rate limit",
      "rule": "luau-shield007",
      "severity": "low",
      "slug": "remote-without-rate-limit",
      "snippet": "ReplicatedStorage.Remotes.SetBio.OnServerEvent:Connect(function(player, request) -- expect: luau-shield007",
      "title": "Remote handler does expensive work without a rate limit",
      "why": "Exploiters can fire a remote thousands of times per second. Without a limit, each call spends DataStore/HTTP budgets, creates instances or yields, which is enough to lag or crash the server and to exhaust request quotas for everyone."
    },
