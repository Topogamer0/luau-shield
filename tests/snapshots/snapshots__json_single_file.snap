    {
      "column": 12,
      "end_column": 32,
      "end_line": 29,
      "file": "tests/fixtures/luau-shield001/vulnerable/datastore-client-key.server.luau",
      "fix": "The key is not checked against an allow-list (or a strict pattern): the client chooses which entry is written, for example `Coins` or another player's save. Let the server decide amounts (look prices and rewards up in a server table by an allow-listed id). If a number must come from the client, check `typeof(x) == \"number\"`, reject NaN (`x ~= x`) and check both bounds before using it. Never use client data as a DataStore key.",
      "flow": [
        {
          "column": 59,
          "file": "tests/fixtures/luau-shield001/vulnerable/datastore-client-key.server.luau",
          "line": 19,
          "note": "`slotKey` (parameter #2) of the `DeleteSlot.OnServerEvent` handler is sent by the client (the type annotation `string` is not checked at runtime)"
        },
        {
          "column": 12,
          "file": "tests/fixtures/luau-shield001/vulnerable/datastore-client-key.server.luau",
          "line": 29,
          "note": "`slotKey` (client-controlled) is used as the key of `slotStore:RemoveAsync()`"
        }
      ],
      "help_uri": "https://github.com/Topogamer0/luau-shield/blob/main/docs/rules/luau-shield001.md",
      "line": 29,
      "message": "`slotKey` (client-controlled) is used as the key of `slotStore:RemoveAsync()`",
      "rule": "luau-shield001",
      "severity": "high",
      "slug": "untrusted-economy-write",
      "snippet": "\tslotStore:RemoveAsync(slotKey) -- expect: luau-shield001",
      "title": "Client-controlled value written to currency, stats or saved data",
      "why": "Exploiters can fire any remote with any arguments. If the server adds a client-supplied amount to a currency, saves a client-supplied table or lets the client pick the DataStore key, an exploiter can give themselves unlimited currency, corrupt other players' data or poison saves with NaN/huge values. Luau type annotations are erased at runtime: they do not validate anything."
    },
    {
      "column": 24,
      "end_column": 5,
      "end_line": 26,
      "file": "tests/fixtures/luau-shield001/vulnerable/datastore-setasync-client-value.server.luau",
      "fix": "Add a per-player cooldown (store `os.clock()` per player and return early when called too often), a busy flag while the previous request is running, or a shared rate limiter module.",
      "flow": [
        {
          "column": 24,
          "file": "tests/fixtures/luau-shield001/vulnerable/datastore-setasync-client-value.server.luau",
          "line": 21,
          "note": "the `SavePlot.OnServerEvent` handler calls `plotStore:SetAsync()` on every request, with no rate limit"
        }
      ],
      "help_uri": "https://github.com/Topogamer0/luau-shield/blob/main/docs/rules/luau-shield007.md",
      "line": 21,
      "message": "the `SavePlot.OnServerEvent` handler calls `plotStore:SetAsync()` on every request, with no rate limit",
      "rule": "luau-shield007",
      "severity": "low",
      "slug": "remote-without-rate-limit",
      "snippet": "SavePlot.OnServerEvent:Connect(function(player: Player, layout: { PlacedObject }) -- expect: luau-shield007",
      "title": "Remote handler does expensive work without a rate limit",
      "why": "Exploiters can fire a remote thousands of times per second. Without a limit, each call spends DataStore/HTTP budgets, creates instances or yields, which is enough to lag or crash the server and to exhaust request quotas for everyone."
    },
