                  "startColumn": 26,
                  "startLine": 44
                }
              }
            }
          ],
          "message": {
            "text": "credential `tsk_live_4f9…` is hard-coded in a ModuleScript replicated to clients: every player can read it. Move the secret to the server (ServerScriptService/ServerStorage), store it with Roblox secrets (`HttpService:GetSecret`) and revoke the leaked credential."
          },
